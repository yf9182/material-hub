{
  "name": "material-hub-nano-banana",
  "main": "dist/server/index.js",
  "compatibility_date": "2026-05-15",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "vars": {
    "OSS_REGION": "ap-southeast-1",
    "OSS_ENDPOINT": "https://oss-ap-southeast-1.aliyuncs.com",
    "OSS_BUCKET": "material-hub-nano-sg-7f3a"
  },
  "assets": {
    "directory": "dist/client",
    "binding": "ASSETS"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "material-hub-db",
      "database_id": "954aaee8-425d-48f3-981a-02ddbcf7a347"
    }
  ],
  "r2_buckets": [
    {
      "binding": "MATERIAL_ASSETS",
      "bucket_name": "material-hub-assets"
    }
  ]
}
